# Which debug probe serves which bench, as `probe-rs list` prints it after `--`
# (VID:PID:Serial). hil/probe.sh reads this file for any board variable the
# environment leaves unset, and uses a line only while that probe is attached;
# otherwise it falls back to finding the bench's die by DEV_ID. Pinning skips
# that scan, which opens every attached probe in turn (five on this rig).
# Read from each die's DBGMCU_IDCODE on 2026-11-14 (hil/RIG.md, Which probe); the F767
# (0x10016451) read again on 2026-11-18.
F401_PROBE=0483:374b:0674FF555185754867115446
H753_PROBE=0483:374e:0013002D4142500720353451
DISCOVERY_PROBE=0483:374b:0673FF495170535067225844
F767_PROBE=0483:374b:066EFF565380535067104408
