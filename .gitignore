# Build output, for the crate and every firmware and check package in it.
target/

# Written by the HIL scripts on every run.
hil/logs/

# Python byte-code from tools/check_docs.py and tools/housekeeping.py.
__pycache__/
*.pyc

# The root holds only these documents; any other root .md is temporary (a review
# record, a draft) and never committed (docs/policies/documentation.md).
/*.md
!/README.md
!/AGENTS.md
!/THIRD-PARTY.md
